+def test_global_hybrid_admission_replaces_per_group_transient_reserve():
+    model_config = SimpleNamespace(max_model_len=6144)
+    vllm_config = SimpleNamespace(
+        model_config=model_config,
+        scheduler_config=SimpleNamespace(
+            hybrid_kv_cache_admission=False,
+            hybrid_kv_speculative_admission=False,
+        ),
+        parallel_config=SimpleNamespace(decode_context_parallel_size=1),
+        max_in_flight_tokens=1024,
+    )
+    spec = SlidingWindowSpec(
+        block_size=16,
+        num_kv_heads=16,
+        head_size=256,
+        dtype=torch.float8_e4m3fn,
+        sliding_window=1024,
+    )
+
+    default_blocks = (
+        spec.max_memory_usage_bytes(vllm_config) // spec.page_size_bytes
+    )
+    assert default_blocks == spec.max_admission_blocks_per_request(
+        vllm_config.max_in_flight_tokens,
+        model_config.max_model_len,
+    )
+
+    vllm_config.scheduler_config.hybrid_kv_cache_admission = True
+    global_admission_blocks = (
+        spec.max_memory_usage_bytes(vllm_config) // spec.page_size_bytes
+    )
+    assert global_admission_blocks == spec.max_admission_blocks_per_request(
+        0,
+        model_config.max_model_len,
+    )
+    assert global_admission_blocks < default_blocks
+
