From bfe0cb2b68d818f6c8a78077a8e275ea94103886 Mon Sep 17 00:00:00 2001
From: "Eko J. Salim" <eko@ekojs.com>
Date: Wed, 5 Aug 2026 14:50:45 +0700
Subject: [PATCH 1/3] Fix attention selection for language-only Gemma

Assisted-by: OpenAI Codex
---
 tests/model_executor/layers/test_attention.py | 23 +++++++++++++++++++
 .../layers/attention/attention.py             |  9 +++++++-
 2 files changed, 31 insertions(+), 1 deletion(-)
 create mode 100644 tests/model_executor/layers/test_attention.py

diff --git a/tests/model_executor/layers/test_attention.py b/tests/model_executor/layers/test_attention.py
new file mode 100644
index 000000000..ba8855400
--- /dev/null
+++ b/tests/model_executor/layers/test_attention.py
@@ -0,0 +1,23 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from types import SimpleNamespace
+
+import pytest
+
+from vllm.model_executor.layers.attention.attention import _should_use_mm_prefix
+
+
+@pytest.mark.parametrize(
+    ("is_mm_prefix_lm", "language_model_only", "expected"),
+    [(False, False, False), (True, False, True), (True, True, False)],
+)
+def test_language_only_model_does_not_require_mm_prefix_backend(
+    is_mm_prefix_lm: bool, language_model_only: bool, expected: bool
+) -> None:
+    model_config = SimpleNamespace(
+        is_mm_prefix_lm=is_mm_prefix_lm,
+        multimodal_config=SimpleNamespace(language_model_only=language_model_only),
+    )
+
+    assert _should_use_mm_prefix(model_config) is expected
diff --git a/vllm/model_executor/layers/attention/attention.py b/vllm/model_executor/layers/attention/attention.py
index 375049d3b..53882f30c 100644
--- a/vllm/model_executor/layers/attention/attention.py
+++ b/vllm/model_executor/layers/attention/attention.py
@@ -52,6 +52,13 @@ if TYPE_CHECKING:
 logger = init_logger(__name__)
 
 
+def _should_use_mm_prefix(model_config: Any) -> bool:
+    if model_config is None or not model_config.is_mm_prefix_lm:
+        return False
+    multimodal_config = model_config.multimodal_config
+    return multimodal_config is None or not multimodal_config.language_model_only
+
+
 def validate_kv_sharing_target(
     current_layer_name, target_layer_name, static_forward_context
 ):
@@ -342,7 +349,7 @@ class Attention(nn.Module, AttentionLayerBase):
 
         # NOTE: model_config may be None during certain tests
         model_config = vllm_config.model_config
-        self.use_mm_prefix = model_config is not None and model_config.is_mm_prefix_lm
+        self.use_mm_prefix = _should_use_mm_prefix(model_config)
 
         # During model initialization, the default dtype is set as the model
         # weight and activation dtype.
