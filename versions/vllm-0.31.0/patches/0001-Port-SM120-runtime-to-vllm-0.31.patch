+                        torch.tensor([context_len + row + 1], dtype=torch.int32),
+                        block_table[sequence : sequence + 1],
+                        1,
+                    )
+                )
+        sequential_output = torch.cat(sequential_rows)
+
+    torch.testing.assert_close(block_output, sequential_output, atol=0, rtol=0)
+
