+            max_seqlen_k=int(run_seq_lens.max()),
+            softmax_scale=scale,
+            causal=True,
+            window_size=window_size,
+            block_table=run_block_table,
+            softcap=0,
+            q_descale=None,
+            k_descale=torch.full(descale_shape, k_scale.item(), dtype=torch.float32),
+            v_descale=torch.full(descale_shape, v_scale.item(), dtype=torch.float32),
+            seq_threshold_3D=seq_threshold_3d,
