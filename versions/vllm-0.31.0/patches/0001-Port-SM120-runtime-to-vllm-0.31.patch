diff --git a/vllm/v1/attention/backend.py b/vllm/v1/attention/backend.py
index 319b9977f..c0217a04f 100644
--- a/vllm/v1/attention/backend.py
+++ b/vllm/v1/attention/backend.py
@@ -782,6 +782,50 @@ class AttentionMetadataBuilder(ABC, Generic[M]):
         return False
 
 
+def resolve_kv_scale_owner(layer: torch.nn.Module) -> torch.nn.Module:
+    """Return the attention layer that owns a shared KV cache's K/V scales."""
+    owner_ref = getattr(layer, "_kv_scale_owner_ref", None)
+    if owner_ref is None:
+        return layer
+    owner = owner_ref()
+    if owner is None:
+        raise RuntimeError("shared KV-cache scale owner was released")
+    return owner
+
+
+def sync_kv_scale_consumer(consumer: torch.nn.Module, owner: torch.nn.Module) -> None:
+    """Synchronize compatibility copies for backends reading consumer fields.
+
+    Triton and FlashInfer resolve the owner directly. Copies keep existing
+    backends correct for static scales and cover host/device cached fields.
+    """
+    for name in ("_k_scale", "_v_scale", "_k_scale_cpu", "_v_scale_cpu"):
+        destination = getattr(consumer, name)
+        source = getattr(owner, name)
+        if destination.shape != source.shape:
+            raise ValueError(
+                f"shared KV-cache scale shape mismatch for {name}: "
+                f"consumer={tuple(destination.shape)}, owner={tuple(source.shape)}"
+            )
+        destination.copy_(source)
+    consumer._k_scale_float = owner._k_scale_float
+    consumer._v_scale_float = owner._v_scale_float
+    consumer.calculate_kv_scales = False
+
+
+def sync_kv_scale_consumers(owner: torch.nn.Module) -> None:
+    """Refresh all live consumers after owner scales load or are calculated."""
+    consumer_refs = getattr(owner, "_kv_scale_consumer_refs", ())
+    live_refs = []
+    for consumer_ref in consumer_refs:
+        consumer = consumer_ref()
+        if consumer is not None:
+            sync_kv_scale_consumer(consumer, owner)
+            live_refs.append(consumer_ref)
+    if consumer_refs:
+        object.__setattr__(owner, "_kv_scale_consumer_refs", live_refs)
+
+
 class AttentionLayer(Protocol):
     _q_scale: torch.Tensor
     _k_scale: torch.Tensor
