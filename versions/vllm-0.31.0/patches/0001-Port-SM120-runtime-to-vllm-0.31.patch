+
+    scratch_tokens = seq_threshold_3d * 3
+    scratch_output = torch.empty(
+        scratch_tokens,
+        num_query_heads,
+        num_segments,
+        head_size,
+        dtype=torch.float32,
+    )
+    scratch_max = torch.empty(
+        scratch_tokens,
+        num_query_heads,
+        num_segments,
+        dtype=torch.float32,
+    )
+    scratch_expsum = torch.empty_like(scratch_max)
+
+    def run(
