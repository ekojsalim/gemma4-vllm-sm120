+        )
+        return output
+
+    block_output = run(
+        query,
+        query_start,
+        seq_lens,
+        block_table,
+        query_len,
+    )
+    sequential_rows = []
+    if batch_size > seq_threshold_3d:
+        for row in range(query_len):
+            sequential_rows.append(
+                run(
+                    query.reshape(
+                        batch_size,
+                        query_len,
+                        num_query_heads,
+                        head_size,
+                    )[:, row],
+                    torch.arange(batch_size + 1, dtype=torch.int32),
+                    torch.full(
