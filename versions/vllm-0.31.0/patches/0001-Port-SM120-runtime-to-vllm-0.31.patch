+        descale_shape = (num_run_seqs, num_kv_heads)
+        unified_attention(
+            q=run_query,
+            k=key_cache,
+            v=value_cache,
+            out=output,
+            cu_seqlens_q=run_query_start,
+            max_seqlen_q=run_max_query_len,
